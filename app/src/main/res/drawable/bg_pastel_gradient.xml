<?xml version="1.0" encoding="utf-8"?>
<!-- Fond de l'écran : rose -> lavande -> jaune -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/pastel_rose"
        android:centerColor="@color/pastel_lavande"
        android:endColor="@color/pastel_jaune"
        android:type="linear" />
</shape>
