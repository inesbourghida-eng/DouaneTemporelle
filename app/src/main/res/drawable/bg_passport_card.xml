<?xml version="1.0" encoding="utf-8"?>
<!-- Carte "passeport" : fond crème, bord plein lavande + pointillés rose à l'intérieur -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/creme_carte" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="@color/pastel_lavande_fonce" />
        </shape>
    </item>
    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/pastel_rose_fonce"
                android:dashWidth="6dp"
                android:dashGap="4dp" />
        </shape>
    </item>
</layer-list>
