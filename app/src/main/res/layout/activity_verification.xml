<?xml version="1.0" encoding="utf-8"?>
<!-- el wajiha ethnya: el passeport ezzmeni -->
<!-- el jedhr: LinearLayout ofo9i, 3al isar sora b wazn 0.3 w 3al limin RelativeLayout b wazn 0.7 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_racine_ib"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/creme_passeport"
    android:fitsSystemWindows="true">

    <!-- el sora 3al isar: el 3ard 0dp m3a wazn 0.3 -->
    <ImageView
        android:id="@+id/iv_passeport_ib"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:contentDescription="Icone du passeport temporel"
        android:src="@drawable/ic_passeport" />

    <!-- el ktiba 3al limin: el 3ard 0dp m3a wazn 0.7 -->
    <RelativeLayout
        android:id="@+id/rl_textes_ib"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:layout_margin="8dp"
        android:padding="12dp"
        android:background="@drawable/bordure_billet">

        <!-- 3onwen el passeport -->
        <TextView
            android:id="@+id/tv_titre_passeport_ib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="PASSEPORT TEMPOREL"
            android:textColor="@color/brun_passeport"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <!-- esm el msafer -->
        <TextView
            android:id="@+id/tv_nom_ib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_titre_passeport_ib"
            android:layout_marginTop="16dp"
            android:textColor="@color/brun_passeport"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <!-- 3am el wiladha -->
        <TextView
            android:id="@+id/tv_naissance_ib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_nom_ib"
            android:layout_marginTop="8dp"
            android:textColor="@color/brun_passeport"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <!-- 3am el wejha -->
        <TextView
            android:id="@+id/tv_destination_ib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_naissance_ib"
            android:layout_marginTop="8dp"
            android:textColor="@color/brun_passeport"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <!-- el 3omr ezzmeni = 3am el wejha - 3am el wiladha -->
        <TextView
            android:id="@+id/tv_age_ib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_destination_ib"
            android:layout_marginTop="8dp"
            android:textColor="@color/brun_passeport"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <!-- sabab el safar -->
        <TextView
            android:id="@+id/tv_motif_ib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_age_ib"
            android:layout_marginTop="8dp"
            android:textColor="@color/brun_passeport"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <!-- tanbih el paradoxe: mkhabbi ml loul w yodhher ken lazem -->
        <TextView
            android:id="@+id/tv_alerte_ib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_motif_ib"
            android:layout_marginTop="12dp"
            android:text="PARADOXE DETECTE : saut non autorise"
            android:textColor="@color/rouge_refuse"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- zerr el rafdh fel ta7t (n3arrfouh louwel bech el zerr el akher yet3alla9 bih) -->
        <Button
            android:id="@+id/btn_refuser_ib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="Refuser (Risque de paradoxe)"
            android:textSize="12sp" />

        <!-- zerr el mwafa9a fou9 zerr el rafdh -->
        <Button
            android:id="@+id/btn_approuver_ib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/btn_refuser_ib"
            android:layout_marginBottom="8dp"
            android:text="Approuver le saut temporel"
            android:textSize="12sp" />

    </RelativeLayout>
</LinearLayout>