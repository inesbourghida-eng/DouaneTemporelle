<?xml version="1.0" encoding="utf-8"?>
<!-- el wajiha el loula: formulaire mta3 tasjil el msafer 3abr ezzmen -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sv_main_ib"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- 7awi 3amoudi (men fou9 l ta7t) fih kol 3anaser el formulaire -->
    <LinearLayout
        android:id="@+id/ll_form_ib"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 3onwen el wajiha -->
        <TextView
            android:id="@+id/tv_titre_ib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DOUANE TEMPORELLE"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- 7a9l esm el msafer -->
        <TextView
            android:id="@+id/tv_label_nom_ib"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nom du voyageur" />

        <EditText
            android:id="@+id/et_nom_ib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex : Marty McFly"
            android:inputType="textPersonName" />

        <!-- 7a9l 3am el wiladha: ar9am bark w 4 5anat ken -->
        <TextView
            android:id="@+id/tv_label_naissance_ib"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Année de naissance" />

        <EditText
            android:id="@+id/et_naissance_ib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex : 1990"
            android:inputType="number"
            android:maxLength="4" />

        <!-- 7a9l 3am el wejha: ar9am bark w 4 5anat ken -->
        <TextView
            android:id="@+id/tv_label_destination_ib"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Année de destination" />

        <EditText
            android:id="@+id/et_destination_ib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex : 2050"
            android:inputType="number"
            android:maxLength="4" />

        <!-- sabab el safar: tnejem tekhtar wa7da bark -->
        <TextView
            android:id="@+id/tv_label_motif_ib"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Motif du voyage" />

        <RadioGroup
            android:id="@+id/rg_motif_ib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rb_tourisme_ib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tourisme" />

            <RadioButton
                android:id="@+id/rb_modification_ib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modification du passé" />

            <RadioButton
                android:id="@+id/rb_fuite_ib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fuite" />
        </RadioGroup>

        <!-- zerr el fa7s mta3 el profil -->
        <Button
            android:id="@+id/btn_inspecter_ib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Inspecter le profil" />

    </LinearLayout>
</ScrollView>